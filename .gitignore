# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Impeccable design-skill: settings.local.json wires Claude Code hooks to
# run the engine binary below, both of which are per-developer-machine
# artifacts (a 20MB+ OS/arch-specific compiled binary; "local" settings are
# Claude Code's personal-not-shared tier) - each teammate who wants the
# hooks runs `npx impeccable install` themselves, which fetches their own
# platform's binary and writes their own local hook wiring. The skill docs/
# reference/agents themselves stay committed so everyone gets the skill.
.claude/settings.local.json
.claude/skills/impeccable/scripts/bin/
