# --- Anthropic (required) ---
# Server-side only. Never expose this to the browser.
ANTHROPIC_API_KEY=

# --- Vercel Blob (optional locally, required for uploads in production) ---
# Create a Blob store in the Vercel dashboard and copy its token here.
# Without this, the app still works end-to-end - it just skips storing a
# short-lived copy of the original creative (captions still generate fine
# from the client-resized image/frames).
BLOB_READ_WRITE_TOKEN=

# --- Vercel KV / Upstash Redis (optional locally, required for brand
# profiles, rate limiting, and usage logging) ---
# Vercel KV is deprecated in favor of the Upstash Redis integration on
# Vercel Marketplace, but @vercel/kv still works against it - just connect
# an Upstash Redis store and copy these two values from its "Quickstart".
# Without these, Mode B (inferred voice) still works; brand profiles,
# rate limiting, and the usage page will just be empty/disabled.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Auth.js / Google sign-in (optional locally) ---
# Without these set, auth is disabled entirely (no login wall) so Stages
# 1-4 are easy to test locally. Set these to turn on real Google sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Restricts sign-in to this email domain (e.g. reactmarketing.agency).
# Leave unset locally to allow any Google account once OAuth is configured.
ALLOWED_EMAIL_DOMAIN=
# Required by Auth.js in production; generate with `npx auth secret`.
AUTH_SECRET=

# --- Cron (optional) ---
# If set, the /api/cron/cleanup-blobs route requires this as a Bearer token.
# Vercel sends it automatically for scheduled Cron Jobs once configured in
# Project Settings - set the same value here and there.
CRON_SECRET=
